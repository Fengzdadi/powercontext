# Local development (host) addresses — the app connects to services on the
# host machine. compose containers get their own addresses via the
# `environment:` block in docker-compose.yml and ignore this file.

# seekdb — local dev connects to the host-mapped port
SEEKDB_HOST=127.0.0.1
SEEKDB_PORT=10800
SEEKDB_USER=root
SEEKDB_PASSWORD=change-me
SEEKDB_DATABASE=examradar

# PowerContext — local dev address
POWERCONTEXT_URL=http://127.0.0.1:18801

# App
APP_HOST=127.0.0.1
APP_PORT=18800
CORS_ORIGINS=http://localhost:18800

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# BGE retrieval instruction for queries. Empty by default: measured on the
# acceptance queries it hurt short Chinese term queries (see DEVLOG).
# To enable: EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# LLM (optional)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Coverage thresholds (M2)
COVERAGE_T_COVERED=0.55
COVERAGE_T_THIN=0.20

# Leitner intervals (days)
LEITNER_INTERVALS=1,2,4,7,14

# ---------------------------------------------------------------------------
# compose-only variables (used by docker-compose.yml, not by the app):
#   SEEKDB_HOST=seekdb         # container network name
#   SEEKDB_PORT=2881           # container-internal port
#   POWERCONTEXT_URL=http://powercontext:8000
#   APP_HOST=0.0.0.0
#   SEEKDB_HOST_PORT=10800     # host port mapping for seekdb
#   POWERCONTEXT_HOST_PORT=18801
# These are set in docker-compose.yml `environment:` blocks.
