# seekdb connection (container network addresses in compose; host addresses for local dev)
SEEKDB_HOST=seekdb
SEEKDB_PORT=2881
SEEKDB_USER=root
SEEKDB_PASSWORD=change-me
SEEKDB_DATABASE=examradar
# Host-only: port mapping for docker compose
SEEKDB_HOST_PORT=10800

# PowerContext (container network address in compose)
POWERCONTEXT_URL=http://powercontext:8000
POWERCONTEXT_HOST_PORT=18801

# App
APP_HOST=0.0.0.0
APP_PORT=18800
CORS_ORIGINS=http://localhost:18800

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=

# LLM (optional)
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Coverage thresholds (M2)
COVERAGE_T_COVERED=0.55
COVERAGE_T_THIN=0.20

# Leitner intervals (days)
LEITNER_INTERVALS=1,2,4,7,14
