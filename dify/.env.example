# 喵青天·鸡毛蒜皮法庭 —— 配套服务的配置。使用前复制一份：cp .env.example .env
# 这里只有占位值，请按需修改；不要把真实密码提交到仓库（.env 已被 .gitignore 忽略）。

# ---- 必填 ----
# seekdb 的 root 密码（只有 court-api 用它连库；seekdb 端口默认只绑定 127.0.0.1）。
SEEKDB_ROOT_PASSWORD=change-me-please

# ---- 与 Dify 的连接 ----
# Dify 社区版 docker compose 创建的网络名。在 Dify 源码的 docker/ 目录里启动时默认是 docker_default，
# 可用 `docker network ls` 确认。court-api 和 powercontext 会加入这个网络，Dify 用服务名访问它们。
DIFY_NETWORK=docker_default

# ---- 宿主机端口（只用于调试和查看数据；Dify 走 docker 网络，不依赖这些端口）----
BIND_ADDRESS=127.0.0.1
SEEKDB_HOST_PORT=22881
COURT_API_HOST_PORT=18080
POWERCONTEXT_HOST_PORT=18000

# ---- 资源 ----
SEEKDB_MEMORY_LIMIT=2G

# ---- 构建镜像时的下载源 ----
# 国内网络可改用镜像，例如：
#   PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
#   HF_ENDPOINT=https://hf-mirror.com
PIP_INDEX_URL=https://pypi.org/simple
HF_ENDPOINT=https://huggingface.co
